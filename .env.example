# ==========================================
# CHAT AI - Environment Configuration
# ==========================================

# 1. ONLINE MODE: Google Gemini API Key
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. OFFLINE MODE: Ollama Service Endpoint
# Default local Ollama URL is http://localhost:11434
OLLAMA_ENDPOINT=http://localhost:11434

# 3. Next.js Port (optional, defaults to 3000)
PORT=3000

